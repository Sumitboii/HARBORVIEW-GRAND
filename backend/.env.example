PORT=4000
# Optional: without this, the backend runs in fallback mode — answers are
# retrieved directly from the grounded knowledge base facts instead of a
# real model call. Useful for demoing/testing without credentials.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=models/gemini-3.6-flash
ANTHROPIC_API_KEY=

# Admin and frontend keys
ADMIN_KEY=admin-secret-key-123
FRONTEND_API_KEY=frontend-api-key-456
